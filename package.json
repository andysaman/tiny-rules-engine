{
  "name": "tiny-rules-engine",
  "version": "0.1.0",
  "private": true,
  "description": "A tiny, readable rules engine for front-end business logic demos",
  "type": "module",
  "scripts": {
    "demo": "node --experimental-strip-types src/demo.ts",
    "lint:style": "node --experimental-strip-types scripts/check-early-return-spacing.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" && npm run lint:style"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.6.3"
  },
  "license": "MIT"
}
